# Copy this file to .env and fill in real values.
# NEVER commit .env to version control. In production, secrets live in Coolify env
# and are injected at runtime — they are NOT baked into the container image (D-07).

# === REQUIRED (process fails fast at startup if unset) ===
# Postgres connection string (api + worker + migrate).
DATABASE_URL=
# Anthropic API key (worker scoring). Never commit a real key.
ANTHROPIC_API_KEY=
# API bearer credentials: comma-separated `token:consumer_id` pairs (api).
# Each consumer_id is dedup-scoped (DEDUP_TTL is a 1h window per consumer). Give the
# scheduled re-audit caller its OWN `cron` entry, and the inline embedder its own
# `ottolax` entry (CONS-02), so neither dedups against ad-hoc human submissions.
# Example (PLACEHOLDER tokens — never commit real secrets):
#   GEO_API_KEYS=REPLACE_ME_HUMAN:dashboard,REPLACE_ME_CRON:cron,REPLACE_ME_OTTOLAX:ottolax
GEO_API_KEYS=

# === API tunables ===
# HTTP listen port for the API role.
PORT=8080

# === WORKER tunables (all optional — defaults shown) ===
# Max concurrent in-flight audits.
WORKER_CONCURRENCY=3
# Poll loop interval in ms (also the heartbeat refresh cadence).
POLL_INTERVAL_MS=1000
# Job lease TTL in seconds.
LEASE_TTL_SECONDS=120
# Reclaim sweep interval in ms (default: floor(LEASE_TTL_SECONDS/2)*1000).
RECLAIM_INTERVAL_MS=
# Max attempts before a job is failed permanently.
MAX_ATTEMPTS=3
# Per-job scoring timeout in ms.
SCORING_TIMEOUT_MS=60000
# Graceful-shutdown drain window in ms. Coolify stop grace MUST be >= this (D-09).
SHUTDOWN_GRACE_MS=30000
# Anthropic model used for scoring.
SCORING_MODEL=claude-sonnet-4-6
# Worker liveness heartbeat file (read by scripts/worker-healthcheck.sh).
WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat

# === CRON / SCHEDULED RE-AUDIT (Phase 7) ===
# Run target: `bun packages/cron/dist/main.js` (one-shot; fired by a Coolify Scheduled
# Task — see docs/deploy.md). It POSTs /audit to the deployed API per target URL using a
# dedicated `cron` consumer bearer. All values below are REQUIRED at cron startup except
# CRON_SCHEDULE (informational). Var names mirror packages/cron/src/env.ts exactly.

# Audit targets — comma- OR newline-separated list of http(s) site URLs to re-audit.
# Each is validated (new URL() + http(s) protocol) before any POST. Example placeholders:
CRON_TARGET_URLS=https://example.com,https://example.org
# Bearer for the dedicated `cron` consumer — MUST equal the token part of the `:cron`
# entry in GEO_API_KEYS above. PLACEHOLDER; never commit a real token.
CRON_API_TOKEN=REPLACE_ME_CRON
# Base URL (origin) of the deployed geo-api the cron POSTs to. Trailing slash stripped.
# In Coolify, use the internal/service hostname of the API resource.
GEO_API_BASE_URL=http://localhost:8080
# Informational only — this is the value the operator enters into Coolify's Scheduled-Task
# frequency field; the cron process itself does NOT self-schedule. Default `0 4 * * *`.
# UTC. MUST fire LESS than once per hour or re-audits silently dedup (see docs/deploy.md).
CRON_SCHEDULE=0 4 * * *
