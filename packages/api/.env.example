# @geo/api environment (no real secrets committed)

# Bearer API keys: CSV of token:consumer_id pairs (D-03/D-05).
# Split on the FIRST ":" per pair; pairs separated by ",".
GEO_API_KEYS=token1:consumer1,token2:consumer2

# Postgres connection (Coolify env in prod; never commit a real value).
DATABASE_URL=postgres://user:pass@localhost:5432/geo_seo

# HTTP listen port (default 8080).
PORT=8080
